{
  "manifest_version": 3,
  "name": "I-Pilot – Eye-Gaze Browsing",
  "short_name": "I-Pilot",
  "version": "0.1.0",
  "description": "Hands-free browsing with webcam eye gaze, semantic element snapping and blink-confirmed selection. All video is processed on your device.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "I-Pilot" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "offscreen", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause / resume I-Pilot"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
